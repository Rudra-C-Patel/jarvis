# Jarvis runtime config. Copy to jarvis.env and edit. Everything binds to 127.0.0.1;
# no cloud endpoints are configured. jarvis.env is gitignored.

# --- Ollama ---
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_NO_CLOUD=1

# --- Open WebUI: local single user, offline ---
JARVIS_PORT=8484
WEBUI_NAME=Jarvis
WEBUI_AUTH=False
ENABLE_SIGNUP=False
CORS_ALLOW_ORIGIN=http://127.0.0.1:8484
OFFLINE_MODE=True
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ENABLE_PERSISTENT_CONFIG=False
ENABLE_OLLAMA_API=True
OLLAMA_BASE_URL=http://127.0.0.1:11434
ENABLE_OPENAI_API=False
ENABLE_DIRECT_CONNECTIONS=False
ENABLE_DIRECT_INTEGRATIONS=False
ENABLE_WEB_SEARCH=False
ENABLE_COMMUNITY_SHARING=False
ENABLE_VERSION_UPDATE_CHECK=False
ENABLE_EVALUATION_ARENA_MODELS=False
ENABLE_PIP_INSTALL_FRONTMATTER_REQUIREMENTS=False
ENABLE_OAUTH_SIGNUP=False
ENABLE_OTEL=False
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# --- Retrieval (embeddings via local Ollama) ---
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL_AUTO_UPDATE=False
RAG_RERANKING_MODEL_AUTO_UPDATE=False
WHISPER_MODEL_AUTO_UPDATE=False
RAG_TOP_K=6
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RAG_EMBEDDING_BATCH_SIZE=1
ENABLE_RETRIEVAL_QUERY_GENERATION=False

# --- Jarvis ---
JARVIS_BASE_MODEL="CHANGE_ME_ollama-model-tag"      # e.g. a local model that fits your RAM
JARVIS_NUM_CTX=32768
JARVIS_RECENT_DAILY=5
JARVIS_USER_NAME="CHANGE_ME_your-first-name"        # speaker label for your messages in chat history
# JARVIS_VAULT=~/PersonalBrain            # Obsidian vault, read-only
# JARVIS_PROJECTS=Work,School,Side projects   # tags used when summarizing chat history
# JARVIS_CORE_TITLE="CHANGE_ME_chat title"          # optional: one chat to build life-context.md from
# JARVIS_CORE_DATE=YYYY-MM-DD
# JARVIS_GPA_MIN=                         # optional: hide GPA mentions at or below this value

# --- Voice (local only) ---
# STT: "" = Open WebUI's built-in faster-whisper, on this machine
AUDIO_STT_ENGINE=
WHISPER_MODEL=small.en
WHISPER_MODEL_DIR="CHANGE_ME/jarvis/data/whisper"
BYPASS_PYDUB_PREPROCESSING=False
# TTS: "" = browser on-device voices only (privacy-guard.js hides network voices)
AUDIO_TTS_ENGINE=
AUDIO_REALTIME_ENABLED=False
